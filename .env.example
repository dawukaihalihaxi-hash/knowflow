# Copy to .env in project root. Never commit or share its contents in chat.
DASHSCOPE_API_KEY=
SUPABASE_URL=
# Server-only Supabase Secret API key (sb_secret_...), or legacy service_role JWT.
# Never use anon/publishable keys. Never put this in a browser.
SUPABASE_SECRET_KEY=

# Required for production deployment; do not commit actual values.
# APP_ENV=production
# APP_CONFIG=config/rag.railway.json
# APP_ADMIN_PASSWORD=
# APP_USER_PASSWORD=
# APP_SESSION_SECRET=

# New enterprise deployment only, starts the setup wizard when registry is absent.
# APP_START_EMPTY=1

# Platform operations only. Keep disabled for normal assistant configuration.
APP_ALLOW_ADVANCED_SETTINGS=0
